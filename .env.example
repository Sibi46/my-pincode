# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Django
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key

# Database (use a dedicated app user, NOT root)
DB_NAME=localjobs_db
DB_USER=mypincod_app
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=localhost
DB_PORT=3306

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=OUR PINCODE <your-email@gmail.com>

# OTP / SMS
TWO_FACTOR_API_KEY=your-2factor-api-key

# AI (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
